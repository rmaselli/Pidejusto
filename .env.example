# Database
DATABASE_URL=postgresql://pidejusto:pidejusto@localhost:5432/pidejusto

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production-use-long-random-string
NODE_ENV=development

# Auth mode: "demo" (local role picker) | "azure" (MS365 OAuth)
AUTH_MODE=demo

# Microsoft Entra ID (required when AUTH_MODE=azure)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:4000/auth/callback

# SAP provider: "mock" | "http"
SAP_PROVIDER=mock
SAP_BASE_URL=https://sap-service-layer.example.local
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
SAP_TIMEOUT_MS=15000

# Claude / Anthropic (optional — local fallback if empty)
ANTHROPIC_API_KEY=

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
